{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/npm", { "pkgRoot": "packages/cli", "tarballDir": "release" }],
    ["@semantic-release/github", { "assets": [{ "path": "release/*.tgz" }] }]
  ]
}
